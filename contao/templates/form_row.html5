<?php

$this->wrapperAttributes = $this->attrs()
    ->addClass([$this->prefix, $this->class])
    ->setIfExists('toolparamdescription', $this->webmcp_toolparamdescription)
    ->mergeWith($this->wrapperAttributes)
;

?>

<div<?= $this->wrapperAttributes ?>>
  <?php $this->block('label'); ?>
  <?php $this->endblock(); ?>

  <?php $this->block('field'); ?>
  <?php $this->endblock(); ?>
</div>
