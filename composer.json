{
    "name": "inspiredminds/contao-webmcp-forms",
    "description": "MCP attributes for the Contao form generator.",
    "type": "contao-bundle",
    "license": "LGPL-3.0-or-later",
    "homepage": "https://github.com/inspiredminds/contao-webmcp-forms",
    "authors": [
        {
            "name": "INSPIRED MINDS",
            "homepage": "https://www.inspiredminds.at"
        }
    ],
    "support": {
        "issues": "https://github.com/inspiredminds/contao-webmcp-forms/issues",
        "source": "https://github.com/inspiredminds/contao-webmcp-forms"
    },
    "funding": [
        {
            "type": "github",
            "url": "https://github.com/sponsors/fritzmg"
        }
    ],
    "require": {
        "php": ">=8.1",
        "contao/core-bundle": "^5.3 || ^6.0"
    },
    "autoload": {
        "psr-4": {
            "InspiredMinds\\ContaoWebMcpForms\\": "src/"
        }
    },
    "extra": {
        "contao-manager-plugin": "InspiredMinds\\ContaoWebMcpForms\\ContaoManager\\Plugin",
        "bamarni-bin": {
            "bin-links": false,
            "forward-command": false
        }
    },
    "require-dev": {
        "bamarni/composer-bin-plugin": "^1.4",
        "shipmonk/composer-dependency-analyser": "^1.8"
    },
    "config": {
        "allow-plugins": {
            "bamarni/composer-bin-plugin": true,
            "contao-community-alliance/composer-plugin": true,
            "contao-components/installer": true,
            "dealerdirect/phpcodesniffer-composer-installer": true,
            "php-http/discovery": false
        }
    },
    "scripts": {
        "cs": [
            "@rector",
            "@ecs"
        ],
        "ecs": "@php vendor-bin/ecs/vendor/bin/ecs --fix",
        "rector": "@php vendor-bin/rector/vendor/bin/rector"
    }
}
